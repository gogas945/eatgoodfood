# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API с platform.claude.com (начинается с sk-ant-)
ANTHROPIC_API_KEY=
# Твой Telegram ID. Оставь пустым, запусти бота и напиши ему /start: он пришлёт ID
ALLOWED_USER_ID=
# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow
# Файл базы данных
DB_PATH=food.db
# Модель Claude. Дешевле, но чуть менее точно: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
